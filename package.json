{
  "name": "car-finder",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "pipeline:search": "tsx pipeline/src/search.ts",
    "pipeline:reconcile": "tsx pipeline/src/reconcile.ts",
    "pipeline:classify": "tsx pipeline/src/classify.ts",
    "app:dev": "concurrently -k -n api,web -c blue,green \"pnpm api:dev\" \"pnpm web:dev\"",
    "app:start": "tsx api/src/server.ts",
    "api:dev": "tsx watch api/src/server.ts",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "mcp:server": "tsx mcp-server/src/server.ts",
    "mcp:smoke": "tsx mcp-server/src/smoke.ts",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed-known-issues": "tsx prisma/seedKnownIssues.ts",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/manrope": "^5.3.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "axios": "^1.13.5",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.1",
    "https-proxy-agent": "^7.0.6",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "prisma": "7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.0.18"
  },
  "packageManager": "pnpm@11.15.1"
}
