{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals"],
    "outDir": "dist"
  },
  "include": [
    "pipeline/src/**/*.ts",
    "pipeline/test/**/*.ts",
    "shared/src/**/*.ts",
    "mcp-server/src/**/*.ts",
    "mcp-server/test/**/*.ts",
    "api/src/**/*.ts",
    "api/test/**/*.ts",
    "prisma/seedKnownIssues.ts"
  ]
}
