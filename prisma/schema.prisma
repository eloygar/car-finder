generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum IssueCategory {
  mecanica
  chapa
  interior
  otros
}

model VehicleModel {
  id        String       @id @default(uuid())
  brand     String
  name      String
  slug      String
  listings  Listing[]
  issues    KnownIssue[]
  createdAt DateTime     @default(now())

  @@unique([brand, name])
  @@index([brand])
  @@index([slug])
}

model Listing {
  id           String    @id @default(uuid())
  externalId   String
  provider     String    @default("wallapop")
  title        String
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  brand        String
  model        String
  year         Int?
  mileage      Int?
  fuelType     String?
  transmission String?
  power        Int?
  bodyType     String?
  province     String?
  latitude     Float?
  longitude    Float?
  url          String
  images       String[]
  publishedAt  DateTime?
  sellerType   String?
  sellerName   String?

  status      String   @default("active")
  contentHash String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  rawPayload  Json?

  classification        Json?     @db.JsonB
  classificationVersion String?
  classifiedAt          DateTime?

  vehicleModelId String?
  vehicleModel   VehicleModel? @relation(fields: [vehicleModelId], references: [id])

  @@unique([provider, externalId])
  @@index([brand, model])
  @@index([brand, model, status])
  @@index([vehicleModelId])
  @@index([province])
  @@index([price])
  @@index([status])
}

model KnownIssue {
  id               String       @id @default(uuid())
  vehicleModelId   String
  vehicleModel     VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  brand            String
  model            String
  yearFrom         Int?
  yearTo           Int?
  issueDescription String
  category         IssueCategory @default(otros)
  severity         String
  source           String?
  contentHash      String
  createdAt        DateTime     @default(now())

  @@unique([vehicleModelId, contentHash])
  @@index([brand, model])
}
