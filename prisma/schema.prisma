generator client {
  provider     = "prisma-client"
  output       = "./generated/client"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Listing {
  id           String    @id @default(uuid())
  externalId   String
  provider     String    @default("wallapop")
  title        String
  description  String?
  price        Decimal   @db.Decimal(12, 2)
  brand        String
  model        String
  year         Int?
  mileage      Int?
  fuelType     String?
  transmission String?
  power        Int?
  bodyType     String?
  province     String?
  latitude     Float?
  longitude    Float?
  url          String
  images       String[]
  publishedAt  DateTime?
  sellerType   String?
  sellerName   String?

  status      String   @default("active")
  contentHash String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  rawPayload  Json?

  classification         Json?                   @db.JsonB
  classificationVersion  String?
  classifiedAt           DateTime?
  vehicleModelId         String?
  knownModelIssuesId     String?
  vehicleModel           VehicleModel?           @relation(fields: [vehicleModelId], references: [id], onDelete: SetNull)
  knownModelIssues       KnownModelIssues?       @relation(fields: [knownModelIssuesId], references: [id], onDelete: SetNull)
  listingIssueExtraction ListingIssueExtraction?

  @@unique([provider, externalId])
  @@index([brand, model])
  @@index([brand, model, status])
  @@index([province])
  @@index([price])
  @@index([status])
  @@index([vehicleModelId, year])
  @@index([knownModelIssuesId])
}

model ListingIssueExtraction {
  id              String                 @id @default(uuid())
  listingId       String                 @unique
  inputHash       String
  anthropicModel  String
  analysisVersion String
  extractedAt     DateTime
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  listing         Listing                @relation(fields: [listingId], references: [id], onDelete: Cascade)
  issues          ListingDetectedIssue[]

  @@index([inputHash])
  @@map("listing_issue_extractions")
}

model ListingDetectedIssue {
  id           String                  @id @default(uuid())
  extractionId String
  issueKey     String
  category     String
  description  String
  evidence     String[]
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  extraction   ListingIssueExtraction  @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  assessment   ListingIssueAssessment?

  @@unique([extractionId, issueKey])
  @@index([category])
  @@map("listing_detected_issues")
}

model ListingIssueAssessment {
  id                  String               @id @default(uuid())
  detectedIssueId     String               @unique
  severity            String
  estimatedCostMinEUR Int
  estimatedCostMaxEUR Int
  reasoning           String
  sources             Json                 @db.JsonB
  pricingYear         Int
  anthropicModel      String
  analysisVersion     String
  assessedAt          DateTime
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  detectedIssue       ListingDetectedIssue @relation(fields: [detectedIssueId], references: [id], onDelete: Cascade)

  @@index([severity])
  @@index([assessedAt])
  @@map("listing_issue_assessments")
}

model VehicleModel {
  id                    String                 @id @default(uuid())
  source                String                 @default("wallapop")
  brand                 String
  model                 String
  normalizedBrand       String
  normalizedModel       String
  taxonomyStatus        String
  taxonomySchemaVersion Int?
  taxonomyCapturedAt    DateTime?
  active                Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  listings              Listing[]
  knownIssues           KnownModelIssues[]
  issueAssessments      ModelIssueAssessment[]

  @@unique([source, normalizedBrand, normalizedModel])
  @@index([brand, model])
  @@map("vehicle_models")
}

model ModelIssueAssessment {
  id                  String       @id @default(uuid())
  vehicleModelId      String
  issueKey            String
  issueText           String
  severity            String
  estimatedCostMinEUR Int
  estimatedCostMaxEUR Int
  reasoning           String
  sources             Json         @db.JsonB
  pricingYear         Int
  anthropicModel      String
  analysisVersion     String
  assessedAt          DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  vehicleModel        VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)

  @@unique([vehicleModelId, issueKey])
  @@index([severity])
  @@index([assessedAt])
  @@map("model_issue_assessments")
}

model KnownModelIssues {
  id              String       @id @default(uuid())
  vehicleModelId  String
  year            Int
  mechanical      String[]
  bodywork        String[]
  interior        String[]
  other           String[]
  sources         Json         @db.JsonB
  hasIssues       Boolean
  analysisVersion String
  anthropicModel  String
  researchedAt    DateTime
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  vehicleModel    VehicleModel @relation(fields: [vehicleModelId], references: [id], onDelete: Cascade)
  listings        Listing[]

  @@unique([vehicleModelId, year])
  @@index([hasIssues])
  @@map("known_model_issues")
}

model KnownIssue {
  id               String  @id @default(uuid())
  brand            String
  model            String
  yearFrom         Int?
  yearTo           Int?
  issueDescription String
  severity         String
  source           String?

  @@index([brand, model])
}
